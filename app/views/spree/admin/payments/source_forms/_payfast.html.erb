<%
  # Admin source form partial — shown when manually creating a PayFast payment from admin.
  param_prefix = "payment_source[#{payment_method.id}]"
%>
<fieldset data-id="payfast-source">
  <div id="payfast_form_<%= payment_method.id %>" class="mt-3 row" data-hook>
    <%= hidden_field_tag "#{param_prefix}[m_payment_id]", @order.number %>
    <%= hidden_field_tag "#{param_prefix}[status]", 'pending' %>
    <div class="col-12">
      <p class="text-muted">
        PayFast payments are processed via redirect. No additional fields are required here.
      </p>
    </div>
  </div>
</fieldset>
