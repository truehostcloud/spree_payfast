# Ignore documentation generated by YARD
doc/

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore Byebug command history file.
.byebug_history

# Ignore rspec tmp cache
.rspec-local
.rspec_results

# Coverage results
coverage/

# Mac OS files
.DS_Store

# Ignore test dummy app
spec/dummy

# Build files
*.gem
pkg/

# Vendor
vendor/bundle
